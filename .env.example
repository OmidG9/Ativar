# مقصد دریافت درخواست‌های فرم تماس
# یکی از دو روش زیر را پیکربندی کنید. اگر هیچ‌کدام تنظیم نشود،
# در محیط توسعه درخواست پذیرفته می‌شود اما ارسال نمی‌گردد و در
# محیط production پاسخ 503 برگردانده می‌شود.

# روش ۱: وبهوک (Slack، Make، n8n، تلگرام و ...)
CONTACT_WEBHOOK_URL=

# روش ۲: ارسال ایمیل با Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
