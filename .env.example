# مقصدهای دریافت درخواست‌های فرم تماس
# می‌توانید یک یا چند مقصد را هم‌زمان فعال کنید؛ درخواست به همه مقصدهای
# فعال ارسال می‌شود و اگر دست‌کم یکی موفق شود، ثبت درخواست موفق در نظر
# گرفته می‌شود. اگر هیچ مقصدی تنظیم نشود، در محیط توسعه درخواست پذیرفته
# می‌شود اما ارسال نمی‌گردد و در production پاسخ 503 برگردانده می‌شود.

# ۱) ربات تلگرام (پیشنهادی برای اطلاع سریع)
# ربات را با BotFather بسازید، به گروه/چت موردنظر اضافه کنید و chat_id را
# از getUpdates یا @userinfobot بگیرید.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ۲) ایمیل با Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ۳) وبهوک عمومی (Slack، Make، n8n و ...)
CONTACT_WEBHOOK_URL=

# تنظیمات پیشرفته (اختیاری) — فقط برای Bot API خودمیزبان یا پروکسی
# TELEGRAM_API_BASE=https://api.telegram.org
# RESEND_API_BASE=https://api.resend.com

# تحلیل بازدید (اختیاری) — بدون تنظیم این دو مقدار، هیچ اسکریپت بیرونی بارگذاری نمی‌شود.
# سازگار با Plausible، Umami و سرویس‌های مشابه.
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
# NEXT_PUBLIC_ANALYTICS_DOMAIN=ativar.ir

# تأیید مالکیت در Google Search Console (اختیاری)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

